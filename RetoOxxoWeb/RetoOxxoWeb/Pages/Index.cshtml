@page
@model IndexModel

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pagina Principal</title>
</head>
<body>
    <div class="container mt-4">
        <div class="row">
            <div class="col-md-3">
                <a href="/Privacy" class="tarjetas-botones">
                    <div class="card custom-card">
                        <div class="card-body">
                            <h5 class="card-title text-center">Ranking</h5>
                            <div class="ranking-list-index mt-3">
                                <!--Usuario 1 -->
                                <div class="ranking-item d-flex align-items-center mb-3">
                                    <img src="https://cdn.pixabay.com/photo/2021/06/07/13/46/user-6318011_1280.png" alt="Imagen de usuario" class="img-rank">
                                    <p class="ranking-username-index mb-0 ms-4">Heriberto Saenz</p>
                                </div>
                                <!--Usuario 2 -->
                                <div class="ranking-item d-flex align-items-center mb-3">
                                    <img src="https://cdn.pixabay.com/photo/2021/06/07/13/46/user-6318011_1280.png" alt="Imagen de usuario" class="img-rank">
                                    <p class="ranking-username-index mb-0 ms-4">Tú</p>
                                </div>
                                <!--Usuario 3 -->
                                <div class="ranking-item d-flex align-items-center mb-3">
                                    <img src="https://cdn.pixabay.com/photo/2021/06/07/13/46/user-6318011_1280.png" alt="Imagen de usuario" class="img-rank">
                                    <p class="ranking-username-index mb-0 ms-4">Miranda Lopez</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
            
            <div class="col-md-6">
                <a href="/Privacy" class="tarjetas-botones">
                    <div class="card custom-card">
                        <div class="card-body">
                            <h5 class="card-title text-center">Progreso de Capacitación</h5>
                            <div class="progress-list">
                                <!-- Primera Estadistica-->
                                <div class="d-flex align-items-center mb-3">
                                    <p class="mb-0 me-3 progress-text">Manejo de visitas</p>
                                    <div class="progress w-100">
                                        <div class="progress-bar progress-bar-index" role="progressbar" style="width: 75%;" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100">
                                            75%
                                        </div>
                                    </div>
                                </div>
                                <!-- Segunda Estadistica-->
                                <div class="d-flex align-items-center mb-3">
                                    <p class="mb-0 me-3 progress-text">Manejo de tiempo</p>
                                    <div class="progress w-100">
                                        <div class="progress-bar progress-bar-index" role="progressbar" style="width: 75%;" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100">
                                            75%
                                        </div>
                                    </div>
                                </div>
                                <!-- Tercera Estadistica-->
                                <div class="d-flex align-items-center mb-3">
                                    <p class="mb-0 me-3 progress-text">Manejo de recursos</p>
                                    <div class="progress w-100">
                                        <div class="progress-bar progress-bar-index" role="progressbar" style="width: 75%;" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100">
                                            75%
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-md-3">
                <div class="card custom-card">
                    <div class="card-body">
                        <h5 class="card-title text-center">Métricas de tiendas</h5>
                        <p class="card-text">Numero de tiendas: 25 </p>
                        <p class="card-text">Profit: 25</p>
                        <p class="card-text">Empleados: 25</p>
                        <p class="card-text">Perdidas: 25</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
