@page "{id:int}"
<!-- Esto indica que la pagina acepta un parametro llamado id -->
@model RetoOxxoWeb.Pages.Perfil.EditarPerfilModel
@{
    ViewData["Title"] = "Editar Perfil";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/EditarPerfil.css" asp-append-version="true" />
    <title>Document</title>
</head>
<body>
    
    <h2 class="titulo-editar">Editar Perfil</h2>
    <form method="post" class="formulario-perfil" enctype="multipart/form-data" novalidate>
        <!-- Formulario que enviará los datos mediante método POST-->

        <input type="hidden" asp-for="Usuario.id_usuario"/>
        <!--Campo oculto para enviar el ID del usuario, necesario para hacer el UPDATE correcto-->
        <div class="form-grid">
            <div class="group-input">
                <label asp-for="Usuario.nom_usuario">Nombre de usuario</label>
                <input asp-for="Usuario.nom_usuario" class="form-control" />
                <span asp-validation-for="Usuario.nom_usuario" class="error-message"></span>
            </div>

            <div class="group-input">
                <label asp-for="Usuario.tipo_empleado">Tipo de empleado</label>
                <select asp-for="Usuario.tipo_empleado" class="form-control">
                    <option value="">Seleccione un tipo de empleado</option>
                    <option value="0">Gerente</option>
                    <option value="1">Asesor</option>
                </select>
                <span asp-validation-for="Usuario.tipo_empleado" class="error-message"></span>
            </div>

            <div class="group-input">
                <label asp-for="Usuario.nombre">Nombre</label>
                <input asp-for="Usuario.nombre" class="form-control" />
                <span asp-validation-for="Usuario.nombre" class="error-message"></span>
            </div>

            <div class="group-input">
                <label asp-for="Usuario.contraseña">Contraseña</label>
                <input asp-for="Usuario.contraseña" type="password" class="form-control" />
                <span asp-validation-for="Usuario.contraseña" class="error-message"></span>
            </div>

            <div class="group-input">
                <label asp-for="Usuario.ConfirmarContraseña">Confirmar contraseña</label>
                <input asp-for="Usuario.ConfirmarContraseña" type="password" class="form-control" />
                <span asp-validation-for="Usuario.ConfirmarContraseña" class="error-message"></span>
            </div>


            <div class="group-input">
                <label asp-for="Usuario.apellidop">Primer apellido</label>
                <input asp-for="Usuario.apellidop" class="form-control" />
                <span asp-validation-for="Usuario.apellidop" class="error-message"></span>
            </div>

            <div class="group-input">
                <label asp-for="Usuario.calle">Calle</label>
                <input asp-for="Usuario.calle" class="form-control" />
                <span asp-validation-for="Usuario.calle" class="error-message"></span>
            </div>

            <div class="group-input">
                <label asp-for="Usuario.apellidom">Segundo apellido</label>
                <input asp-for="Usuario.apellidom" class="form-control" />
                <span asp-validation-for="Usuario.apellidom" class="error-message"></span>
            </div>

            <div class="group-input">
                <label asp-for="Usuario.estado">Estado</label>
                <select asp-for="Usuario.estado" class="form-control">
                    <option value="">Seleccione un estado</option>
                    <option>CDMX</option>
                    <option>Nuevo León</option>
                    <option>Jalisco</option>
                </select>
                <span asp-validation-for="Usuario.estado" class="error-message"></span>
            </div>

            <div class="group-input">
                <label asp-for="Usuario.telefono">Teléfono</label>
                <input asp-for="Usuario.telefono" class="form-control" />
                <span asp-validation-for="Usuario.telefono" class="error-message"></span>
            </div>

            <div class="group-input">
                <label asp-for="Usuario.ciudad">Ciudad</label>
                <select asp-for="Usuario.ciudad" class="form-control">
                    <option value="">Seleccione una ciudad</option>
                    <option>Ciudad A</option>
                    <option>Ciudad B</option>
                    <option>Ciudad C</option>
                </select>
                <span asp-validation-for="Usuario.ciudad" class="error-message"></span>
            </div>

            <div class="group-input">
                <label asp-for="Usuario.fotografia">Fotografía</label>
                <input asp-for="Usuario.fotografia" type="file" class="form-control" accept="image/*" />
                <span asp-validation-for="Usuario.fotografia" class="error-message"></span>
            </div>

            <div class="group-input">
                <label asp-for="Usuario.cp">Código Postal</label>
                <input asp-for="Usuario.cp" class="form-control" />
                <span asp-validation-for="Usuario.cp" class="error-message"></span>
            </div>
        </div>

        
        <div class="btn-container">
            <button type="submit" class="btn btn-primary">Guardar Cambios</button>
            <button type="reset" class="btn btn-secondary">Limpiar</button>
        </div>
    </form>

</body>

</html>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}