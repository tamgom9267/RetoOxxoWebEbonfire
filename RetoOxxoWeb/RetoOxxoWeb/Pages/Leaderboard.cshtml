@page
@model LeaderboardModel

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leaderboard</title>
    <link rel="stylesheet" href="~/css/Leaderboard.css" asp-append-version="true">
</head>
<body>
    <br></br>
    <div class="text-center">
        <h1 class="p-4 text-center rounded" style="background-color: #ffdead; display: inline-block; font-size: 50px;">
            Leaderboards
        </h1>
    </div>
    <br></br>
    <div class="row align-items-center">
        <div class="col-5">
            <div class="container">
                <h2>Clasificación General (Semanal)</h2>
                <div class="table-responsive" style="height: 200px; overflow-y: auto;">
                    <table class="table table-bordered">
                    <thead class="table-dark">
                        <tr>
                        <th scope="col">Posición</th>
                        <th scope="col">Usuario</th>
                        <th scope="col">Puntaje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{var count = 1;}
                        @foreach (var usuario in Model.Puntajes){
                            <tr class="rowClass">
                                <th scope="row">@count</th>
                                <td>@usuario.nombre</td>
                                <td>@usuario.puntos_totales</td>
                            </tr>
                            count++;
                        }
                    </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-2"></div>
        <div class="col-5">
            <div class="container">
                <h2>Clasificación por logros</h2>
                <div class="table-responsive" style="height: 200px; overflow-y: auto;">
                    <table class="table table-bordered">
                    <thead class="table-dark">
                        <tr>
                        <th scope="col">Posición</th>
                        <th scope="col">Usuario</th>
                        <th scope="col">Logros Completos</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{var count2 = 1;}
                        @foreach (var usuario in Model.Logros){
                            <tr>
                                <th scope="row">@count2</th>
                                <td>@usuario.nombre</td>
                                <td>@usuario.total_logros</td>
                            </tr>
                            count2++;
                        }
                    </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>
