@page
@model LeaderboardModel

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leaderboard</title>
    <link rel="stylesheet" href="~/css/Leaderboard.css" asp-append-version="true">
</head>
<body>

    <br>
    <div class="text-center">
        <h1 class="p-4 text-center rounded">Leaderboards</h1>
    </div>
    <br>
    <div class="text-center mt-4">
    <h2 style="color: #c00;">🏆 Premio del Mes 🏆</h2>
    <p style="font-size: 20px; font-weight: bold; color: #c90;">
        <span style="color: #333;">Ganador:</span> @Model.PrimerLugar
    </p>
    <p style="font-size: 18px; color: #c00;">🎁 @Model.PremioDelMes 🎁</p>
    </div>

    <div class="row justify-content-center">
        <!-- Clasificación General -->
        <div class="col-md-5">
            <div class="container">
                <h2 style="color: #c00;">Clasificación General (Semanal)</h2>
                <div class="table-responsive" style="height: 250px; overflow-y: auto;">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Posición</th>
                                <th>Usuario</th>
                                <th>Puntaje</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var count = 1; }
                            @foreach (var usuario in Model.Puntajes) {
                                string rowClass = count == 1 ? "gold" : count == 2 ? "silver" : count == 3 ? "bronze" : "";
                                <tr class="@rowClass">
                                    <th>@count</th>
                                    <td>@usuario.nombre</td>
                                    <td>@usuario.puntos_totales</td>
                                </tr>
                                count++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-1"></div>

        <!-- Clasificación por Logros -->
        <div class="col-md-5">
            <div class="container">
                <h2 style="color: #c00;">Clasificación por Logros</h2>
                <div class="table-responsive" style="height: 250px; overflow-y: auto;">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Posición</th>
                                <th>Usuario</th>
                                <th>Logros Completos</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var count2 = 1; }
                            @foreach (var usuario in Model.Logros) {
                                <tr>
                                    <th>@count2</th>
                                    <td>@usuario.nombre</td>
                                    <td>@usuario.total_logros</td>
                                </tr>
                                count2++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
