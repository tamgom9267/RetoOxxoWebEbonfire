@page
@model LeaderboardModel

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leaderboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        body { font-family: 'Poppins', sans-serif; background-color: #f8f8f8; }
        .top-3 img { width: 50px; }
        .gold { color: gold; }
        .silver { color: silver; }
        .bronze { color: #cd7f32; }
        .card { box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1); }
    </style>
</head>
<body>
    <div class="container mt-4">
        <h1 class="text-center text-white bg-danger p-3 rounded">Leaderboards</h1>
        
        <div class="card p-4">
            <!-- Tabs -->
            <ul class="nav nav-tabs" id="leaderboardTabs">
                <li class="nav-item">
                    <a class="nav-link active" data-bs-toggle="tab" href="#puntajes">Puntajes Generales</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="tab" href="#logros">Logros</a>
                </li>
            </ul>
            
            <div class="tab-content mt-3">
                <!-- Puntajes Generales -->
                <div class="tab-pane fade show active" id="puntajes">
                    <div class="text-center top-3">
                        <h2>Top 3</h2>
                        <div class="card p-3 bg-light">
                            <p class="gold">🥇 @Model.Puntajes[0].nombre - @Model.Puntajes[0].puntos_totales</p>
                            <p class="silver">🥈 @Model.Puntajes[1].nombre - @Model.Puntajes[1].puntos_totales</p>
                            <p class="bronze">🥉 @Model.Puntajes[2].nombre - @Model.Puntajes[2].puntos_totales</p>
                        </div>
                    </div>
                    <table class="table table-bordered mt-3">
                        <thead class="table-dark">
                            <tr>
                                <th>Posición</th>
                                <th>Usuario</th>
                                <th>Puntaje</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var count = 4; }
                            @foreach (var usuario in Model.Puntajes.Skip(3)) {
                                <tr>
                                    <th>@count</th>
                                    <td>@usuario.nombre</td>
                                    <td>@usuario.puntos_totales</td>
                                </tr>
                                count++;
                            }
                        </tbody>
                    </table>
                </div>
                
                <!-- Logros -->
                <div class="tab-pane fade" id="logros">
                    <table class="table table-bordered">
                        <thead class="table-dark">
                            <tr>
                                <th>Posición</th>
                                <th>Usuario</th>
                                <th>Logros Completos</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var count2 = 1; }
                            @foreach (var usuario in Model.Logros.Skip(3)) {
                                <tr>
                                    <th>@count2</th>
                                    <td>@usuario.nombre</td>
                                    <td>@usuario.total_logros</td>
                                </tr>
                                count2++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        
        <!-- Premio del mes para el primer lugar -->
        <div class="text-center mt-4">
            <button class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#premioModal">🎁 Ver Premio del Mes 🎁</button>
        </div>
        
        <div class="modal fade" id="premioModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Premio del Mes</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p><strong>Ganador:</strong> @Model.Puntajes[0].nombre</p>
                        <p><strong>Premio:</strong> @Model.PremioDelMes</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>