<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RetoOxxoWeb.styles.css" asp-append-version="true" />
</head>
<body>
@inject RetoOxxoWeb.Model.DataBaseContext _context

@{
    var userID = Context.Session.GetInt32("usuarioID");

    string nombreUsuario = "Invitado";

    if (userID != null)
    {
        nombreUsuario = _context.GetNombreUsuario(userID.Value);
    }
}

    <header>
        <div class="header-container">
            @{
                var idUsuario = Context.Session.GetInt32("usuarioID");
            }
            @{
                var nom_usuario = Context.Session.GetString("nombreUsuario");
            }
            @if (idUsuario != null)
            {
                <a href="/EditarPerfil/@Context.Session.GetInt32("usuarioID")" class="navbar-brand">
                    <img src="https://cdn.pixabay.com/photo/2021/06/07/13/46/user-6318011_1280.png" alt="Icono de Usuario" class="menu_usuario">
                </a>
            }
            @if (ViewContext.RouteData.Values["page"]?.ToString() == "/Index")
            {
                <h3 class="titulo">¡Bienvenido/a, @nombreUsuario !</h3>
            }
            <div class="iconos-derecha">
                <a href="#" class="nav-link dropdown-toggle" id="navbarDropdown" data-bs-toggle="dropdown">
                    <img src="/img/Icono_Menu.png" alt="Barras de Navegación" class="menu_usuario">
                </a>
                <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                    <li><a class="dropdown-item" href="/Index">Pagina Principal</a></li>
                    <li><a class="dropdown-item" href="/Progreso_Capacitacion">Capacitaciones</a></li>
                    <li><a class="dropdown-item" href="/Leaderboard">Leaderboard</a></li>
                    <li><a class="dropdown-item" href="/IniciarSesion">Cerrar Sesión</a></li>
                </ul>
            </div>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
