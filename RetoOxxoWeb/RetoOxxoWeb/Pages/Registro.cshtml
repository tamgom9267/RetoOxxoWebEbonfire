@page
@model SignInModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crear Cuenta</title>
    <link rel="stylesheet" href="~/css/IniciarSesion.css" asp-append-version="true">
</head>
<body>
    <div class="main-container">
        <div class="logo-container">
            <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/6/66/Oxxo_Logo.svg/2560px-Oxxo_Logo.svg.png" alt="Logo de OXXO">
        </div>
        <br>
        <div class="container">

            <form method="post">
                <div class="input-group">
                    <label for="usuario">Nombre de usuario:</label>
                    <input type="text" id="nom_usuario" name="Usuario" placeholder="Ingrese su nombre de usuario" required>
                </div>
                <div>
                    <h4>@Model.Mensaje_registro</h4>
                </div>
                <div class="input-group">
                    <label for="password">Contraseña:</label>
                    <input type="password" id="password" name="Contraseña" placeholder="Ingrese su contraseña" required>
                </div>
                <br>
                <hr style="border: 2px solid #666;">
                <div class="input-group">
                    <label for="usuario">Nombre:</label>
                    <input type="text" id="nombre" name="Nombre" placeholder="Ingrese su nombre" required>
                </div>
                <div class="input-group">
                    <label for="apellidoP">Apellido Paterno:</label>
                    <input type="text" id="apellidoP" name="apellidoP" placeholder="Ingrese su apellido paterno" required>
                </div>
                <div class="input-group">
                    <label for="apellidoP">Apellido Materno:</label>
                    <input type="text" id="apellidoM" name="apellidoM" placeholder="Ingrese su apellido materno" required>
                </div>
                <br>
                <hr style="border: 2px solid #666;">
                <div class="input-group">
                    <label for="apellidoP">Teléfono:</label>
                    <input type="text" id="telefono" name="telefono" placeholder="Ingrese su número de teléfono" required>
                </div>
                <button type="submit" class="button login">Aceptar</button>  
                <button type="button" class="button register">
                    <a href="./IniciarSesion">Regresar</a>
                </button>
            </form>
        </div>
    </div>
</body>
</html>
